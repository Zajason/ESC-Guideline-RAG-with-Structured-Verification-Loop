# -----------------------------
# Ignore all folders by default
# -----------------------------
*/

# -----------------------------
# Keep root-level files
# -----------------------------
!*.py
!*.ipynb
!*.md
!.gitignore
!.env.example
!LICENSE
!CITATION.cff
!CONTRIBUTING.md
!SECURITY.md
!pyproject.toml
!requirements.txt

# -----------------------------
# Keep public project folders
# -----------------------------
!.github/
!.github/**
!docs/
!docs/**
!examples/
!examples/**
!esc_rag/
!esc_rag/**
!scripts/
!scripts/**
!tests/
!tests/**

# -----------------------------
# Keep artifacts folder
# -----------------------------
!esc_rag_artifacts/
!esc_rag_artifacts/**

# -----------------------------
# Explicitly ignore these folders
# -----------------------------
.venv/
__pycache__/
.ipynb_checkpoints/
esc_data/
runs/
batch_runs/
swisstransfer_*/
*.xlsx
*.xls
*.docx
*.pages
.env
.env.*
!.env.example

# -----------------------------
# Python cache
# -----------------------------
*.pyc
*.pyo
*.pyd

# -----------------------------
# OS files
# -----------------------------
.DS_Store
Thumbs.db
